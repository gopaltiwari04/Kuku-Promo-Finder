# Copy to .env and fill in only the provider you want. With no key, every run uses the
# zero-cost `heuristic` provider automatically (and says so in the console / UI).
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Optional: point the OpenAI / Anthropic adapters at a proxy or compatible gateway
# OPENAI_BASE_URL=https://api.openai.com/v1
# ANTHROPIC_BASE_URL=https://api.anthropic.com
# OPENAI_JSON_MODE=0      # for OpenAI-compatible servers that reject response_format={"type": "json_object"}
